NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

STT_PROVIDER=mock
TRANSLATION_PROVIDER=mock

STT_START_TIMEOUT_MS=5000
STT_FINAL_TIMEOUT_MS=8000
TRANSLATION_TIMEOUT_MS=5000

LOG_TRANSCRIPTS=false

# Add real provider credentials only to your local .env when a later phase needs them.
# STT_API_KEY=replace-with-stt-api-key
# TRANSLATION_API_KEY=replace-with-translation-api-key
