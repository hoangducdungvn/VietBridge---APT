NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Comma-separated in production. Development also accepts private-LAN port 5173/4173.
CORS_ORIGIN=http://localhost:5173

FPT_API_KEY=your_fpt_api_key_here
LLM_MODEL=Llama-3.3-70B-Instruct
LLM_URL=https://mkp-api.fptcloud.com/v1/chat/completions

STT_PROVIDER=mock
STT_BASE_URL=http://localhost:8001
TRANSLATION_PROVIDER=mock
TRANSLATION_SERVICE_URL=http://localhost:8000

STT_START_TIMEOUT_MS=5000
# Must exceed the STT service final upstream timeout (10s), including queue time.
STT_FINAL_TIMEOUT_MS=15000
# NLLB-200 CPU inference đo thực tế 1700-9391ms/câu — cân nhắc tăng giá trị này khi TRANSLATION_PROVIDER=local, giá trị 5000 mặc định phù hợp hơn cho remote/mock provider.
TRANSLATION_TIMEOUT_MS=5000

LOG_TRANSCRIPTS=false

# Add real provider credentials only to your local .env when a later phase needs them.
# STT_API_KEY=replace-with-stt-api-key
# TRANSLATION_API_KEY=replace-with-translation-api-key
