# Transport cho voice + results (chỉ áp dụng `npm run dev`):
#   socketio → đường tích hợp THẬT: NestJS realtime (turn.start/audio.chunk) → STT HTTP → translation → message.final
#   ws       → fallback: mock-gateway :8081 (không cần NestJS realtime)
VITE_TRANSPORT=socketio
# VITE_TRANSPORT=ws
# VITE_MOCK_GATEWAY_URL=ws://192.168.1.10:8081   # chỉ cần khi ws mode + gateway ở máy khác
