# Local dev: talk straight to the mock gateway (voice/src/mock-server) over raw WS.
# Remove or set VITE_TRANSPORT=socketio to go back to the NestJS Socket.IO path.
VITE_TRANSPORT=ws
# Default is ws://<page-hostname>:8081 — override only if the gateway runs elsewhere:
# VITE_MOCK_GATEWAY_URL=ws://192.168.1.10:8081
