VITE_BACKEND_API_URL=http://localhost:3000
VITE_BACKEND_WS_URL=http://localhost:3000
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_SUPPORTED_LANGUAGES=vi,en

# Transport mode (Phase 1 baseline):
#   ws  = raw WebSocket directly to mock-server (no NestJS required, default for local dev)
#   io  = Socket.IO to NestJS backend (production / Phase 2+)
VITE_TRANSPORT=ws

# URL of the mock ingestion gateway (used when VITE_TRANSPORT=ws)
VITE_MOCK_GATEWAY_URL=ws://localhost:8081
