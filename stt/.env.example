# Copy this file to .env and replace the placeholders with local credentials.
# Never commit stt/.env or real API keys.
FPT_API_KEY=replace-with-fpt-api-key
GROQ_API_KEY=replace-with-groq-api-key

STT_BACKEND=auto
STT_HOST=127.0.0.1
STT_PORT=8001

# Optional server-side EOU metadata in STT responses.
# Client VAD remains the primary utterance boundary; this is an advisory fallback.
STT_EOU_ENABLED=true
STT_EOU_END_SILENCE_MS=600
STT_EOU_MIN_SPEECH_MS=160
STT_EOU_MAX_UTTERANCE_MS=25000
